# ============================================================================
# MoscowRoleplay Voice — пример конфигурации сервера.
#
# Скопируйте файл в .env и замените все заглушки на реальные значения.
# Не коммитьте .env в Git и не передавайте его содержимое третьим лицам.
#
# Пустое значение необязательной переменной означает «интеграция не настроена».
# Переменные без значения по умолчанию обязательны.
# ============================================================================

# ----------------------------------------------------------------------------
# Общие настройки
# ----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# true удобно для локальной разработки; в production принудительно отключается.
LOG_PRETTY=true
SHUTDOWN_TIMEOUT_MS=10000

# ----------------------------------------------------------------------------
# HTTP и WebSocket
# ----------------------------------------------------------------------------
# Для локального запуска безопаснее 127.0.0.1; в Docker Compose переопределяется
# на 0.0.0.0. На VPS без reverse proxy укажите 0.0.0.0.
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
WS_PATH=/ws
WS_MAX_PAYLOAD_BYTES=16384
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_CONNECTIONS=200
WS_RATE_LIMIT_MAX_MESSAGES=30
WS_RATE_LIMIT_WINDOW_MS=10000
WS_MAX_VIOLATIONS=5

# true — только если сервер стоит за доверенным reverse proxy (nginx, Caddy),
# который перезаписывает X-Forwarded-For и X-Forwarded-Host.
TRUST_PROXY=false

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
# Суперпользователь нужен только контейнеру PostgreSQL при первом создании тома.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_password

# Приложение подключается этой ролью. Она создаётся init-скриптом контейнера.
# В production значение change_me_app_password недопустимо: приложение откажется
# запускаться с заглушкой или с паролем, совпадающим с POSTGRES_USER/POSTGRES_DB.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=moscowroleplay_voice
POSTGRES_USER=mrv_app
POSTGRES_PASSWORD=change_me_app_password
# false — для PostgreSQL внутри Docker-сети. Для публичного подключения включите
# true и настройте TLS с проверкой сертификата; не отключайте проверку сертификата.
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_QUERY_TIMEOUT_MS=5000
HEALTH_DB_TIMEOUT_MS=3000

# ----------------------------------------------------------------------------
# Discord OAuth2 и серверные сессии
# ----------------------------------------------------------------------------
# Авторизация включается, только если заданы все три переменные:
# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET и DISCORD_REDIRECT_URI.
# Если задана только часть — сервер не запустится.
#
# Redirect URI должен полностью совпадать с указанным в Discord Developer Portal:
#   https://voice.example.com/auth/discord/callback
# В production допускается только https. Для локальной разработки разрешён
# http://localhost:3000/auth/discord/callback.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# ID Discord-сервера проекта. Нужен для Bloxlink и для проверки ролей
# радиоканалов через Discord Bot API.
DISCORD_GUILD_ID=
DISCORD_TIMEOUT_MS=5000

# Токен бота Discord. Нужен только для закрытых радиоканалов (roleIds не пуст).
# Без него открытые каналы (roleIds: []) работают, закрытые — недоступны.
DISCORD_BOT_TOKEN=
DISCORD_ROLES_CACHE_TTL_MS=60000

# Время жизни серверных сессий. Хранится только SHA-256-хеш токена.
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# В production обязано быть true. Требуется HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_TOUCH_INTERVAL_SECONDS=60
SESSION_CLEANUP_INTERVAL_MS=3600000

# Ограничение частоты запросов к маршрутам /auth/*.
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_STATE_TTL_SECONDS=600
# Необязательный адрес возврата после входа. Для Electron оставьте пустым:
# сервер покажет страницу «Вход выполнен», которую клиент закроет сам.
AUTH_POST_LOGIN_REDIRECT_URL=

# ----------------------------------------------------------------------------
# Bloxlink: связка Discord → Roblox
# ----------------------------------------------------------------------------
# Ключ Bloxlink Server API. Выдаётся в панели Bloxlink и требует, чтобы бот
# Bloxlink был установлен на Discord-сервере DISCORD_GUILD_ID.
# Без ключа вход через Discord работает, но Roblox не привязывается,
# а значит Proximity Voice для пользователя недоступен.
BLOXLINK_API_KEY=
BLOXLINK_API_BASE_URL=https://api.blox.link/v4/public
BLOXLINK_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# Roblox Users API (публичный, ключ не нужен)
# ----------------------------------------------------------------------------
ROBLOX_USERS_API_BASE_URL=https://users.roblox.com
ROBLOX_TIMEOUT_MS=5000

# ----------------------------------------------------------------------------
# PRC ER:LC API V2 и опрос игрового сервера
# ----------------------------------------------------------------------------
# Ключ игрового сервера из панели PRC. Без него опрос отключается,
# Proximity Voice не получает координаты игроков.
PRC_SERVER_KEY=
PRC_API_BASE_URL=https://api.erlc.gg/v2
PRC_TIMEOUT_MS=2500
GAME_POLL_ENABLED=true
# Один опрос на сервер. Не ставьте значение меньше 500 мс.
GAME_POLL_INTERVAL_MS=500
GAME_POLL_MAX_BACKOFF_MS=30000
# Снимок старше этого времени считается устаревшим: связи разрываются.
GAME_STATE_STALE_AFTER_MS=5000

# ----------------------------------------------------------------------------
# mediasoup и голос
# ----------------------------------------------------------------------------
VOICE_ENABLED=true
MEDIASOUP_LISTEN_IP=0.0.0.0
# Публичный IPv4 VPS, который видят клиенты. На VPS обязателен: без него
# клиенты получат внутренний адрес контейнера и не смогут подключиться.
# Не указывайте 127.0.0.1. Для локальной проверки двух клиентов в одной сети
# можно указать локальный IP компьютера.
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40049
# Зарезервировано: текущая реализация создаёт один Worker на процесс.
MEDIASOUP_WORKER_COUNT=1

# ----------------------------------------------------------------------------
# Proximity Voice
# ----------------------------------------------------------------------------
# Радиус слышимости в игровых метрах.
PROXIMITY_MAX_DISTANCE=30
# Запас, в пределах которого связь не создаётся/не рвётся повторно (гистерезис).
PROXIMITY_HYSTERESIS=5
PROXIMITY_UPDATE_INTERVAL_MS=500
PROXIMITY_MAX_NEIGHBORS=16

# ----------------------------------------------------------------------------
# Радиосвязь
# ----------------------------------------------------------------------------
RADIO_ENABLED=true
# Пусто — используется config/radio-channels.json относительно корня проекта.
RADIO_CHANNELS_FILE=
# Максимальная длительность одной передачи. По истечении сервер её завершает.
RADIO_MAX_TRANSMISSION_MS=120000
