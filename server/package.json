{
  "name": "@moscowroleplay/voice-server",
  "version": "0.5.0",
  "private": true,
  "description": "Серверная часть MoscowRoleplay Voice: HTTP, WebSocket, PostgreSQL, mediasoup, proximity и radio",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/database/migrate-cli.js",
    "check": "node scripts/check-syntax.js",
    "shared:sync": "node scripts/sync-shared.js",
    "shared:check": "node scripts/sync-shared.js --check",
    "test": "node --test",
    "verify": "npm run check && npm run shared:check && npm test"
  },
  "dependencies": {
    "mediasoup": "3.32.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "pino-pretty": "13.2.0"
  },
  "license": "UNLICENSED"
}
